{
  "name": "lock-notes-pubsonal",
  "version": "1.0.0",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "dev": "concurrently -n API,CLIENT -c green,cyan \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "cd api && npm run dev",
    "dev:client": "cd client && npm run dev",
    "vercel-dev": "vercel dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vercel": "^32.0.0"
  }
}